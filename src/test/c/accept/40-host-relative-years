federation FIFA {
    tournament Copa {
        teams { "Racing", "river", "Boca", "Independiente" }
        format knockout
        schedule starting may 1 every week
    }

    tournament Eliminatorias {
        teams { "Argentina", "Brasil", "Uruguay", "Chile" }
        format round robin double
        schedule starting september 1 every week
    }
    calendar from 2026 to 2034 {
        every 4 years starting 2030 {
            host Copa
            host Eliminatorias 1 year before
            host Eliminatorias 2 years before
        }
    }
}
