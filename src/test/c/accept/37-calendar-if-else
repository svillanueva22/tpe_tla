federation AFA {
    tournament Copa {
        teams { "Racing", "river", "Boca", "Independiente" }
        format knockout
        schedule starting may 1 every week
    }

    calendar from 2026 to 2034 {
        every year as Y {
            if Y >= 2028 and Y != 2030 or not (Y < 2027) {
                host Copa
            } else {
                host Copa in Y + 1
            }
        }
    }
}
