federation AFA {
    league Primera tier 1 {
        teams { "Racing", "river", "Boca", "Independiente" }
        format round robin
        schedule starting february 1 every sunday
        zone Descenso relegate last
    }
    league Nacional tier 2 {
        teams { "Colón", "Banfield", "Quilmes", "Chacarita" }
        format round robin
        schedule starting february 1 every sunday
        zone Ascenso promote first
    }
    movement {
        relegate Descenso from Primera to Nacional
        promote Ascenso from Nacional to Primera
    }
}
